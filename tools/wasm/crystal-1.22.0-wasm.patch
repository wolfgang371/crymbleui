       {% end %}
+      stub_aggregate_signature_mismatches(llvm_mod) if @codegen_target.architecture == "wasm32"
+    end
+
+    # wasm32, after the optimizer: a direct call or invoke whose function type differs from its callee's, with an
+    # aggregate on either side (a struct or array at the top level of a parameter or the return - not a vector or
+    # pointer, which LLVM handles), gets as its callee an internal stub of the call's own type whose body is
+    # `unreachable`.
+    #
+    # The optimizer makes such calls out of a proc call's two branches (codegen/primitives.cr): once it resolves the
+    # proc's pointer, the branch for the other kind of proc - without closure data on a closure's function, with it
+    # on a plain one - becomes a direct call of the wrong type. Legal IR, and for a proc Crystal builds that branch
+    # never runs. LLVM's WebAssembly backend adapts a mismatched direct call (WebAssemblyFixFunctionBitcasts: an
+    # adapter, or this stub when the types cannot be adapted) only when no aggregate is involved; with one it emits
+    # a call with the wrong number of operands and the module does not validate. Retargeting only the callee operand
+    # (the last one, for a call and an invoke alike) leaves control flow, unwind edges and funclet bundles alone.
+    #
+    # The bitcode cache (must_compile?) compares bitcode from before this step, so it could not see this step change;
+    # wasm32 builds only cross-compile, which never uses that cache. With CRYMBLE_WASM_STUB_REPORT set, says how many
+    # calls and invokes it retargeted.
+    private def stub_aggregate_signature_mismatches(llvm_mod)
+      mismatched = [] of {LLVM::Value, LLVM::Type}
+      llvm_mod.functions.each do |func|
+        func.basic_blocks.each do |block|
+          block.instructions.each do |inst|
+            next unless LibLLVM.is_a_call_inst(inst) || LibLLVM.is_a_invoke_inst(inst)
+            callee = LibLLVM.get_called_value(inst)
+            next unless LibLLVM.is_a_function(callee)
+            call_type = LLVM::Type.new(LibLLVM.get_called_function_type(inst))
+            callee_type = LLVM::Type.new(LibLLVM.global_get_value_type(callee))
+            next if call_type == callee_type
+            mismatched << {inst, call_type} if aggregate_signature?(call_type) || aggregate_signature?(callee_type)
+          end
+        end
+      end
+
+      stubs = {} of {LLVM::Type, LLVM::CallConvention} => LLVM::Function
+      invokes = 0
+      mismatched.each do |inst, call_type|
+        convention = inst.call_convention
+        stub = stubs[{call_type, convention}] ||= llvm_mod.functions.add("__crystal_wasm_mismatched_call", call_type) do |func|
+          func.linkage = LLVM::Linkage::Internal
+          func.call_convention = convention
+          builder = llvm_mod.context.new_builder
+          builder.position_at_end func.basic_blocks.append
+          builder.unreachable
+        end
+        invokes += 1 if LibLLVM.is_a_invoke_inst(inst)
+        LibLLVM.set_operand(inst, LibLLVM.get_num_operands(inst) - 1, stub)
+      end
+      stderr.puts "wasm32 stubs: #{mismatched.size - invokes} calls, #{invokes} invokes" if ENV["CRYMBLE_WASM_STUB_REPORT"]?
+    end
+
+    private def aggregate_signature?(type : LLVM::Type)
+      ([type.return_type] + type.params_types).any?(&.kind.in?(LLVM::Type::Kind::Struct, LLVM::Type::Kind::Array))
     end
 
     private def run_linker(linker_name, command, args)
