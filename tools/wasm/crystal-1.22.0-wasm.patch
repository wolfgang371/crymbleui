@@ -26,7 +26,9 @@ class Crystal::ABI::Wasm32 < Crystal::ABI
 
   private def compute_return_type(rty, ret_def, context)
     if aggregate?(rty)
-      ArgType.indirect(rty, LLVM::Attribute::ByVal)
+      # Returned through a caller-allocated slot passed as a hidden first argument, as clang does
