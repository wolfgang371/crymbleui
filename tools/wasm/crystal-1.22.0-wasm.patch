+
+    # The type a layout node (sizeof, alignof, instance_sizeof, instance_alignof, offsetof) measures, once typed
+    def layout_operand(node : ASTNode) : Type?
+      case node
+      when SizeOf, AlignOf, InstanceSizeOf, InstanceAlignOf then node.exp.type?
+      when OffsetOf                                         then node.offsetof_type.type?
+      else                                                       raise "BUG: #{node.class_desc} is not a layout number"
+      end
+    end
+
+    # Whether a typed layout node becomes a literal - the nodes stock 1.22 folds; the rest (typeof, a module, an
+    # abstract struct) codegen computes. Their errors are raised before: by the main visitor and the cleanup
+    # transformer.
+    def foldable_layout?(node : ASTNode) : Bool
+      return false unless type = layout_operand(node)
+      case node
+      when SizeOf, AlignOf
+        !node.exp.is_a?(TypeOf) && !(type.module? || (type.abstract? && type.struct?))
+      when InstanceSizeOf, InstanceAlignOf
+        !node.exp.is_a?(TypeOf) && type.devirtualize.class? && !type.metaclass? && !type.struct?
+      else
+        true # offsetof: codegen has no way to compute it
+      end
+    end
+
+    def layout_number(node : ASTNode, typer : LLVMTyper) : UInt64
+      type = layout_operand(node).not_nil!
+      case node
+      when SizeOf          then size_of(type.sizeof_type, typer)
+      when AlignOf         then align_of(type.sizeof_type, typer).to_u64
+      when InstanceSizeOf  then instance_size_of(type.sizeof_type, typer)
+      when InstanceAlignOf then instance_align_of(type.sizeof_type, typer).to_u64
+      when OffsetOf
+        index = case offset = node.offset
+                when InstanceVar then type.index_of_instance_var(offset.name).not_nil!
+                else                  offset.as(NumberLiteral).integer_value.to_i
+                end
+        if type.struct? || type.is_a?(TupleInstanceType)
+          offset_of(type.sizeof_type, index, typer)
+        else
+          instance_offset_of(type.sizeof_type, index, typer)
+        end
+      else
+        raise "BUG: #{node.class_desc} is not a layout number"
+      end
+    end
+
+    # A typer over its own context AND its own data layout. LLVM's DataLayout caches struct layouts by the struct
+    # type's address: this context's types in the target machine's shared layout would leave stale entries once the
+    # context is freed, and a struct codegen creates later at the same address would get a dead one's layout
+    # (objects allocated too small). Its owner disposes the layout (LLVMTyper#dispose_layout); the context goes with
+    # the typer.
+    def new_layout_typer : LLVMTyper
+      LLVMTyper.new(self, LLVM::Context.new, LLVM::TargetData.new(LibLLVM.create_target_data_layout(target_machine)))
+    end
+
+    def with_fresh_layout_typer(&)
+      typer = new_layout_typer
+      begin
+        yield typer
+      ensure
+        typer.dispose_layout
+      end
+    end
+
+    # Every layout number folded into a literal, with its value.
+    getter layout_folds = [] of {ASTNode, UInt64}
+
+    def fold_layout(node : ASTNode, typer : LLVMTyper) : NumberLiteral
+      value = layout_number(node, typer)
+      layout_folds << {node, value}
+      NumberLiteral.new(value.to_s, :i32).tap(&.type = int32)
+    end
+
+    # A folded number must be the one the final layout gives - a difference would make code that copies or
+    # indexes by it disagree with the objects codegen lays out.
+    def check_layout_folds : Nil
+      return if layout_folds.empty?
+      with_fresh_layout_typer do |typer|
+        layout_folds.each do |node, value|
+          final = layout_number(node, typer)
+          next if final == value
+          node.raise "#{node} was folded to #{value} before the layout of #{layout_operand(node)} was complete: " \
+                     "its final layout gives #{final}"
+        end
+      end
     end
   end
 
